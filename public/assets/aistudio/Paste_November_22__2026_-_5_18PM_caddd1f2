def has_audio(path: str) -> bool:
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "a",
         "-show_entries", "stream=codec_type", "-of", "csv=p=0", path],
        capture_output=True, text=True,
    ).stdout.strip()
    return bool(out)


def normalize_segment(src, start, length, out_path, vertical_blur=True, use_fade=True):
    """Cut one piece and convert it to 1080x1920, 30fps, stereo audio (so pieces can be joined)."""
    fade = 0.3 if (use_fade and length > 1.5) else 0
    if vertical_blur:
        fc = ("[0:v]scale=1080:1920:force_original_aspect_ratio=increase,"
              "crop=1080:1920,boxblur=25:10[bg];"
              "[0:v]scale=1080:-2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2")
    else:
        fc = "[0:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920"
    fc += ",setsar=1,fps=30,format=yuv420p"
    af = "aresample=44100,aformat=channel_layouts=stereo"
    if fade:
        fc += f",fade=t=in:st=0:d={fade},fade=t=out:st={length - fade:.2f}:d={fade}"
        af += f",afade=t=in:st=0:d={fade},afade=t=out:st={length - fade:.2f}:d={fade}"
    fc += "[outv]"

    audio = has_audio(src)
    cmd = ["ffmpeg", "-y", "-loglevel", "error", "-ss", str(start), "-i", src]
    if not audio:
        cmd += ["-f", "lavfi", "-t", str(length), "-i", "anullsrc=r=44100:cl=stereo"]
    cmd += ["-filter_complex", fc, "-map", "[outv]", "-map", "0:a" if audio else "1:a",
            "-af", af, "-c:v", "libx264", "-preset", "fast", "-crf", "22",
            "-c:a", "aac", "-b:a", "128k", "-ar", "44100", "-ac", "2",
            "-t", str(length), out_path]
    subprocess.run(cmd, check=True)


def finish_montage(joined, ass, out, speed, music, music_vol, use_subs):
    """Burn subtitles, change speed, mix background music."""
    vf = f"setpts=PTS/{speed}"
    if use_subs:
        a = ass.replace("\\", "/").replace(":", "\\:")
        vf = f"subtitles='{a}'," + vf
    cmd = ["ffmpeg", "-y", "-loglevel", "error", "-i", joined]
    if music:
        cmd += ["-stream_loop", "-1", "-i", music]
        fc = (f"[0:v]{vf}[v];[0:a]atempo={speed}[a0];[1:a]volume={music_vol}[m];"
              "[a0][m]amix=inputs=2:duration=first:dropout_transition=0:normalize=0[a]")
    else:
        fc = f"[0:v]{vf}[v];[0:a]atempo={speed}[a]"
    cmd += ["-filter_complex", fc, "-map", "[v]", "-map", "[a]",
            "-c:v", "libx264", "-preset", "fast", "-crf", "22",
            "-c:a", "aac", "-b:a", "160k", "-shortest", out]
    subprocess.run(cmd, check=True)


def join_segments(parts, transition_name, out, td=0.5):
    """Join normalized pieces: plain concat, or crossfade/xfade transitions."""
    tr = TRANSITIONS.get(transition_name)
    if tr is None or len(parts) == 1:
        lst = out + ".txt"
        with open(lst, "w") as f:
            for p in parts:
                f.write(f"file '{os.path.abspath(p)}'\n")
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0",
                        "-i", lst, "-c", "copy", out], check=True)
        os.remove(lst)
        return
    durs = [get_duration(p) for p in parts]
    td = max(0.1, min(td, min(durs) / 3))
    cmd = ["ffmpeg", "-y", "-loglevel", "error"]
    for p in parts:
        cmd += ["-i", p]
    fv, fa = [], []
    vl, al, total = "[0:v]", "[0:a]", durs[0]
    for i in range(1, len(parts)):
        fv.append(f"{vl}[{i}:v]xfade=transition={tr}:duration={td:.2f}:offset={total - td:.3f}[v{i}]")
        fa.append(f"{al}[{i}:a]acrossfade=d={td:.2f}[a{i}]")
        vl, al = f"[v{i}]", f"[a{i}]"
        total += durs[i] - td
    cmd += ["-filter_complex", ";".join(fv + fa), "-map", vl, "-map", al,
            "-c:v", "libx264", "-preset", "fast", "-crf", "22", "-pix_fmt", "yuv420p",
            "-c:a", "aac", "-b:a", "128k", out]
    subprocess.run(cmd, check=True)


def process_montage(files, seg_len, auto_best, transition, vertical_blur, enable_captions,
                    caption_style, enable_hook, hook_text, speed, music, music_vol):
    if not files:
        return None, "Upload at least one video."
    paths = [f if isinstance(f, str) else getattr(f, "name", str(f)) for f in files][:20]
    job = uuid.uuid4().hex[:8]
    work = os.path.join(OUTPUT_DIR, f"montage_{job}")
    os.makedirs(work, exist_ok=True)
    final = os.path.join(OUTPUT_DIR, f"montage_{job}.mp4")
    try:
        parts = []
        for i, p in enumerate(paths):
            dur = get_duration(p)
            length = round(min(float(seg_len), dur), 2)
            start = 0.0
            if auto_best and dur > length:
                start = find_viral_peak_timestamp(p, max(1, int(length)))
                start = max(0.0, min(start, dur - length))
            seg = os.path.join(work, f"seg_{i:02d}.mp4")
            normalize_segment(p, start, length, seg, vertical_blur, use_fade=(transition == "None"))
            parts.append(seg)

        joined = os.path.join(work, "joined.mp4")
        join_segments(parts, transition, joined)

        ass = os.path.join(work, "subs.ass")
        use_subs = bool(enable_captions or (enable_hook and (hook_text or "").strip()))
        if use_subs:
            generate_ass_subtitles(joined, ass, get_duration(joined), enable_captions,
                                   caption_style, enable_hook, hook_text or "")
        finish_montage(joined, ass, final, float(speed), music, float(music_vol), use_subs)
        return final, f"Montage ready: {len(parts)} clips joined."
    except Exception as e:
        return None, f"Error: {e}"
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ---------------------------------------------------------------
# 4) AI Auto-Montage: find the best moments of ONE long video and edit them
# ---------------------------------------------------------------
def audio_energies(path):
    """Loudness (RMS) of every second of the video."""
    if not has_audio(path):
        return np.zeros(0)
    wav = f"{path}_en.wav"
    subprocess.run(["ffmpeg", "-y", "-i", path, "-ac", "1", "-ar", "16000", wav],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    with wave.open(wav, "rb") as wf:
        sr = wf.getframerate()
        data = np.frombuffer(wf.readframes(wf.getnframes()), dtype=np.int16).astype(np.float32)
    os.remove(wav)
    secs = int(len(data) / sr)
    return np.array([np.sqrt(np.mean(data[s * sr:(s + 1) * sr] ** 2)) for s in range(secs)])


def scene_change_times(path, thr=0.35):
    """Times of visual cuts / fast motion (more cuts = more action)."""
    r = subprocess.run(
        ["ffmpeg", "-i", path, "-vf", f"scale=320:-2,select='gt(scene,{thr})',showinfo",
         "-an", "-f", "null", "-"], capture_output=True, text=True)
    return [float(x) for x in re.findall(r"pts_time:([0-9.]+)", r.stderr)]


def analyze_highlights(path, n, seg_len):
    """Score each second = 70% loudness + 30% visual activity, then pick the
    best non-overlapping windows. Returns a sorted list of start times."""
    dur = get_duration(path)
    L = max(1, int(seg_len))
    secs = int(dur)
    if secs <= L:
        return [0.0]
    n = max(1, min(int(n), secs // L))

    score = np.zeros(secs)
    en = audio_energies(path)[:secs]
    if len(en) and en.max() > 0:
        score[:len(en)] += 0.7 * en / en.max()
    sc = np.zeros(secs)
    for t in scene_change_times(path):
        if int(t) < secs:
            sc[int(t)] += 1
    if sc.max() > 0:
        score += 0.3 * sc / sc.max()

    nwin = secs - L + 1
    csum = np.concatenate([[0.0], np.cumsum(score)])
    win = (csum[L:L + nwin] - csum[:nwin]) / L
    picks = []
    for _ in range(n):
        s = int(np.argmax(win))
        if win[s] < 0:
            break
        picks.append(s)
        win[max(0, s - L + 1):min(nwin, s + L)] = -1
    starts = [max(0.0, min(float(s) - 2.0, dur - L)) for s in picks]  # 2s build-up
    return sorted(starts)


def make_hook(segments, fallback="WAIT FOR IT!"):
    """Pick the most 'hooky' spoken sentence (questions, exclamations, numbers)."""
    best, best_score = None, 0
    for seg in segments or []:
        t = seg.text.strip()
        n = len(t.split())
        if n < 3:
            continue
        sc = (2 if "?" in t else 0) + (2 if "!" in t else 0) \
            + (1 if any(c.isdigit() for c in t) else 0) + (1 if 4 <= n <= 10 else 0)
        if sc > best_score:
            best, best_score = t, sc
    if not best:
        return fallback
    words = best.split()
    return " ".join(words[:8]).rstrip(",.;:") + ("..." if len(words) > 8 else "")


def fmt_clock(sec):
    return f"{int(sec // 60):02d}:{int(sec % 60):02d}"


def process_ai_montage(url, upload, cookies, n_clips, seg_len, transition, vertical_blur,
                       enable_captions, caption_style, auto_hook, hook_text,
                       speed, music, music_vol):
    if not (url or "").strip() and not upload:
        return None, "Paste a YouTube link or upload a video."
    job = uuid.uuid4().hex[:8]
    work = os.path.join(OUTPUT_DIR, f"ai_{job}")
    os.makedirs(work, exist_ok=True)
    final = os.path.join(OUTPUT_DIR, f"ai_montage_{job}.mp4")
    try:
        src = os.path.join(work, "source.mp4")
        if upload:
            shutil.copy(upload, src)
        else:
            download_youtube_video(url, src, cookies)

        starts = analyze_highlights(src, n_clips, seg_len)
        dur = get_duration(src)
        length = round(min(float(seg_len), dur), 2)
        parts = []
        for i, st in enumerate(starts):
            seg = os.path.join(work, f"seg_{i:02d}.mp4")
            normalize_segment(src, st, length, seg, vertical_blur, use_fade=(transition == "None"))
            parts.append(seg)

        joined = os.path.join(work, "joined.mp4")
        join_segments(parts, transition, joined)
        total = get_duration(joined)

        segments = None
        if enable_captions or auto_hook:
            segments, _ = whisper_model.transcribe(joined, word_timestamps=True)
            segments = list(segments)
        hook = make_hook(segments, hook_text or "WAIT FOR IT!") if auto_hook else (hook_text or "")

        ass = os.path.join(work, "subs.ass")
        use_subs = bool(enable_captions or hook.strip())
        if use_subs:
            generate_ass_subtitles(joined, ass, total, enable_captions, caption_style,
                                   bool(hook.strip()), hook, segments=segments, hook_seconds=4.0)
        finish_montage(joined, ass, final, float(speed), music, float(music_vol), use_subs)
        moments = ", ".join(fmt_clock(x) for x in starts)
        msg = f"AI montage ready: {len(parts)} moments at {moments}."
        if hook.strip():
            msg += f" Hook: {hook.upper()}"
        return final, msg
    except Exception as e:
        return None, f"Error: {e}"
    finally:
        shutil.rmtree(work, ignore_errors=True)


