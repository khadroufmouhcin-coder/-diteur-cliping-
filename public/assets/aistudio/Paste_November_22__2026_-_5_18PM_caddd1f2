def silence_keep_intervals(path, noise_db=-35, min_silence=0.5, pad=0.12):
    dur = get_duration(path)
    r = subprocess.run(
        ["ffmpeg", "-i", path, "-af", f"silencedetect=noise={noise_db}dB:d={min_silence}",
         "-f", "null", "-"], capture_output=True, text=True)
    starts = [float(x) for x in re.findall(r"silence_start: (-?[0-9.]+)", r.stderr)]
    ends = [float(x) for x in re.findall(r"silence_end: ([0-9.]+)", r.stderr)]
    keep, pos = [], 0.0
    for i, st in enumerate(starts):
        st = max(0.0, st)
        en = ends[i] if i < len(ends) else dur
        if st + pad > pos + 0.05:
            keep.append((pos, min(dur, st + pad)))
        pos = max(pos, en - pad)
    if dur - pos > 0.05:
        keep.append((pos, dur))
    return keep, dur


def process_silence(upload, noise_db, min_silence):
    if not upload:
        return None, "Upload a video."
    job = uuid.uuid4().hex[:8]
    final = os.path.join(OUTPUT_DIR, f"nosilence_{job}.mp4")
    script = os.path.join(OUTPUT_DIR, f"sil_{job}.txt")
    try:
        if not has_audio(upload):
            return None, "This video has no audio."
        keep, dur = silence_keep_intervals(upload, noise_db, min_silence)
        if not keep:
            return None, "Nothing to keep (all silence?). Try a lower threshold."
        expr = "+".join(f"between(t,{a:.3f},{b:.3f})" for a, b in keep)
        with open(script, "w") as f:
            f.write(f"[0:v]select='{expr}',setpts=N/FRAME_RATE/TB[v];"
                    f"[0:a]aselect='{expr}',asetpts=N/SR/TB[a]")
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", upload,
                        "-filter_complex_script", script, "-map", "[v]", "-map", "[a]",
                        "-c:v", "libx264", "-preset", "fast", "-crf", "22",
                        "-c:a", "aac", "-b:a", "128k", final], check=True)
        new = get_duration(final)
        return final, f"Done: {dur:.1f}s -> {new:.1f}s (removed {dur - new:.1f}s of silence)."
    except Exception as e:
        return None, f"Error: {e}"
    finally:
        if os.path.exists(script):
            os.remove(script)


