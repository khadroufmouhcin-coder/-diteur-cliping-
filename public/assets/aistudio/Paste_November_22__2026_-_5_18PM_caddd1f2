def hype_html(count: int, threshold: int) -> str:
    ratio = count / max(1, threshold)
    pct = min(100, int(ratio * 100))
    if ratio >= 1:
        label, color = "PEAK VIRAL HYPE 🔥", "#f97316"
    elif ratio >= 0.7:
        label, color = "VERY HIGH VELOCITY", "#ef4444"
    elif ratio >= 0.35:
        label, color = "BUILDING MOMENTUM", "#8b5cf6"
    else:
        label, color = "CALM", "#9ca3af"
    return f"""
    <div style="padding:10px;border-radius:12px;border:1px solid #ddd">
      <div style="display:flex;justify-content:space-between;font-weight:700">
        <span>🔥 Chat Hype Level</span><span style="color:{color}">{label}</span>
      </div>
      <div style="background:#eee;border-radius:8px;height:14px;margin-top:8px;overflow:hidden">
        <div style="width:{pct}%;height:100%;background:{color}"></div>
      </div>
      <div style="font-size:12px;margin-top:6px;opacity:.7">
        {pct}% hype • {count} comments in last 30s (threshold {threshold})
      </div>
    </div>"""


