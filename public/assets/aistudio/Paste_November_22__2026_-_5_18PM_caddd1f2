def extract_video_id(url: str) -> str:
    patterns = [
        r"youtu\.be/([0-9A-Za-z_-]{11})",
        r"live/([0-9A-Za-z_-]{11})",
        r"shorts/([0-9A-Za-z_-]{11})",
        r"v=([0-9A-Za-z_-]{11})",
    ]
    for p in patterns:
        m = re.search(p, url)
        if m:
            return m.group(1)
    return ""


def get_duration(path: str) -> float:
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "default=nw=1:nk=1", path],
        capture_output=True, text=True,
    ).stdout.strip()
    try:
        return float(out)
    except ValueError:
        return 30.0


def download_youtube_video(url: str, output_path: str, cookies=None) -> str:
    opts = {
        "format": "bestvideo[ext=mp4][height<=1080]+bestaudio[ext=m4a]/best[ext=mp4]/best",
        "outtmpl": output_path,
        "merge_output_format": "mp4",
        "quiet": True,
        "no_warnings": True,
    }
    if cookies:
        opts["cookiefile"] = cookies
    with yt_dlp.YoutubeDL(opts) as ydl:
        ydl.download([url])
    return output_path


def find_viral_peak_timestamp(video_path: str, clip_duration: int) -> float:
    """Loudest window (RMS); start 5 seconds before the peak"""
    if not has_audio(video_path):
        return 0.0
    wav = f"{video_path}_temp.wav"
    subprocess.run(
        ["ffmpeg", "-y", "-i", video_path, "-ac", "1", "-ar", "16000", wav],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
    )
    with wave.open(wav, "rb") as wf:
        sr = wf.getframerate()
        data = np.frombuffer(wf.readframes(wf.getnframes()), dtype=np.int16).astype(np.float32)
    os.remove(wav)

    total = len(data) / sr
    if total <= clip_duration:
        return 0.0

    energies = np.array([
        np.sqrt(np.mean(data[s * sr:(s + 1) * sr] ** 2)) if len(data[s * sr:(s + 1) * sr]) else 0
        for s in range(int(total))
    ])
    best_start, best = 0, -1.0
    for s in range(0, max(1, len(energies) - clip_duration)):
        e = float(np.mean(energies[s:s + clip_duration]))
        if e > best:
            best, best_start = e, s
    return float(max(0, best_start - 5))


def format_ass_time(seconds: float) -> str:
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    s = int(seconds % 60)
    cs = int((seconds - int(seconds)) * 100)
    return f"{h}:{m:02d}:{s:02d}.{cs:02d}"


def karaoke_events(words, per_line=3):
    """Show 3 words at a time and highlight the word being spoken."""
    ev = []
    for i in range(0, len(words), per_line):
        chunk = words[i:i + per_line]
        texts = [w.word.strip().upper() for w in chunk]
        for j, w in enumerate(chunk):
            end = chunk[j + 1].start if j + 1 < len(chunk) else w.end
            parts = []
            for k, t in enumerate(texts):
                if k == j:
                    parts.append("{\\c&H0000FFFF&}" + t + "{\\c&H00FFFFFF&}")
                else:
                    parts.append(t)
            ev.append("Dialogue: 0," + format_ass_time(w.start) + "," + format_ass_time(max(end, w.start + 0.05))
                      + ",CaptionStyle,,0,0,0,," + " ".join(parts))
    return ev


def generate_ass_subtitles(clip_path, ass_path, clip_duration,
                           enable_captions, caption_style, enable_hook, hook_text,
                           segments=None, hook_seconds=None):
    colors = {
        "Viral Yellow": "&H0000FFFF",
        "Neon Cyan": "&H00FFFF00",
        "Modern Clean": "&H00FFFFFF",
        "Karaoke": "&H00FFFFFF",
    }
    karaoke = caption_style == "Karaoke"
    primary = colors.get(caption_style, "&H0000FFFF")

    header = f"""[Script Info]
ScriptType: v4.00+
PlayResX: 1080
PlayResY: 1920

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: CaptionStyle,Arial,68,{primary},&H000000FF,&H00000000,&H80000000,-1,0,0,0,100,100,0,0,1,5,2,2,60,60,340,1
Style: HookStyle,Arial,64,&H00FFFFFF,&H000000FF,&H00000000,&HCC000000,-1,0,0,0,100,100,0,0,3,18,0,8,70,70,220,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""
    events = []
    if enable_hook and (hook_text or "").strip():
        h = hook_text.strip().upper().replace("\n", "\\N")
        hook_end = min(clip_duration, hook_seconds) if hook_seconds else clip_duration
        events.append(f"Dialogue: 1,0:00:00.00,{format_ass_time(hook_end)},HookStyle,,0,0,0,,{h}")

    if enable_captions:
        if segments is None:
            segments, _ = whisper_model.transcribe(clip_path, word_timestamps=True)
        for seg in segments:
            words = seg.words or []
            if words and karaoke:
                events.extend(karaoke_events(words))
            elif words:
                for i in range(0, len(words), 4):
                    chunk = words[i:i + 4]
                    phrase = " ".join(w.word.strip() for w in chunk).upper()
                    events.append(
                        f"Dialogue: 0,{format_ass_time(chunk[0].start)},"
                        f"{format_ass_time(chunk[-1].end)},CaptionStyle,,0,0,0,,{phrase}")
            else:
                events.append(
                    f"Dialogue: 0,{format_ass_time(seg.start)},{format_ass_time(seg.end)},"
                    f"CaptionStyle,,0,0,0,,{seg.text.strip().upper()}")

    with open(ass_path, "w", encoding="utf-8") as f:
        f.write(header + "\n".join(events))


def render_vertical_short(raw_clip, final_out, ass_path, vertical_blur=True):
    ass = ass_path.replace("\\", "/").replace(":", "\\:")
    if vertical_blur:
        fc = ("[0:v]scale=1080:1920:force_original_aspect_ratio=increase,"
              "crop=1080:1920,boxblur=25:10[bg];"
              "[0:v]scale=1080:-2[fg];"
              f"[bg][fg]overlay=(W-w)/2:(H-h)/2,subtitles='{ass}'[outv]")
    else:
        fc = ("[0:v]scale=1080:1920:force_original_aspect_ratio=increase,"
              f"crop=1080:1920,subtitles='{ass}'[outv]")
    subprocess.run(
        ["ffmpeg", "-y", "-i", raw_clip, "-filter_complex", fc,
         "-map", "[outv]", "-map", "0:a?",
         "-c:v", "libx264", "-preset", "fast", "-crf", "22",
         "-c:a", "aac", "-b:a", "128k", final_out],
        check=True,
    )


