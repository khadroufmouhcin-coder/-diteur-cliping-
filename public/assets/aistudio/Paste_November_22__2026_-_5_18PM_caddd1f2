def get_stream_url(url: str, cookies=None) -> str:
    o = {"quiet": True, "no_warnings": True, "format": "best[height<=720]/best"}
    if cookies:
        o["cookiefile"] = cookies
    with yt_dlp.YoutubeDL(o) as ydl:
        info = ydl.extract_info(url, download=False)
    return info["url"]


def monitor_live_stream(url, cookies, duration_choice, threshold, max_wait,
                        vertical_blur, enable_captions, caption_style,
                        enable_hook, hook_text):
    vid = extract_video_id(url)
    if not vid:
        yield None, "Invalid live link.", hype_html(0, threshold)
        return

    duration = int(duration_choice.replace("s", ""))
    job = uuid.uuid4().hex[:8]
    rec_dir = os.path.join(OUTPUT_DIR, f"rec_{job}")
    os.makedirs(rec_dir, exist_ok=True)
    recorder = None

    try:
        yield None, "Connecting to the stream...", hype_html(0, threshold)
        stream_url = get_stream_url(url, cookies)

        # Rolling recording in 5s segments
        recorder = subprocess.Popen(
            ["ffmpeg", "-loglevel", "error", "-i", stream_url, "-c", "copy",
             "-f", "segment", "-segment_time", "5", "-reset_timestamps", "1",
             "-segment_format", "mpegts", os.path.join(rec_dir, "seg_%05d.ts")],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        chat = pytchat.create(video_id=vid)
        stamps = deque()
        t0 = time.time()
        hyped, count = False, 0

        while chat.is_alive() and time.time() - t0 < max_wait:
            for _ in chat.get().sync_items():
                stamps.append(time.time())
            now = time.time()
            while stamps and now - stamps[0] > 30:
                stamps.popleft()
            count = len(stamps)

            # Keep only the last 40 segments (~200s)
            segs = sorted(glob.glob(os.path.join(rec_dir, "seg_*.ts")))
            for old in segs[:-40]:
                os.remove(old)

            yield None, f"Watching chat... ({int(now - t0)}s)", hype_html(count, threshold)
            if count >= threshold:
                hyped = True
                break
            time.sleep(2)

        if not hyped:
            yield None, f"Monitoring time over ({max_wait}s) with no spike.", hype_html(count, threshold)
            return

        yield None, "VIRAL MOMENT DETECTED! Cutting the clip...", hype_html(count, threshold)
        time.sleep(3)
        recorder.terminate()
        recorder.wait(timeout=10)

        segs = sorted(glob.glob(os.path.join(rec_dir, "seg_*.ts")))
        need = max(2, math.ceil(duration / 5))
        chosen = segs[-need:]
        if not chosen:
            yield None, "Nothing was recorded from the stream.", hype_html(count, threshold)
            return

        lst = os.path.join(rec_dir, "list.txt")
        with open(lst, "w") as f:
            for s in chosen:
                f.write(f"file '{os.path.abspath(s)}'\n")
        raw = os.path.join(OUTPUT_DIR, f"live_raw_{job}.mp4")
        ass = os.path.join(OUTPUT_DIR, f"live_subs_{job}.ass")
        final = os.path.join(OUTPUT_DIR, f"live_viral_{job}.mp4")
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0",
             "-i", lst, "-c:v", "libx264", "-c:a", "aac", raw], check=True)

        real_dur = get_duration(raw)
        generate_ass_subtitles(raw, ass, real_dur, enable_captions,
                               caption_style, enable_hook, hook_text)
        render_vertical_short(raw, final, ass, vertical_blur)
        for t in (raw, ass):
            if os.path.exists(t):
                os.remove(t)
        yield final, f"Clip saved ({count} messages/30s)", hype_html(count, threshold)

    except Exception as e:
        yield None, f"Error: {e}", hype_html(0, threshold)
    finally:
        if recorder and recorder.poll() is None:
            recorder.terminate()
        shutil.rmtree(rec_dir, ignore_errors=True)


