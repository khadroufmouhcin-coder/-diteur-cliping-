def process_normal_video(url, upload, cookies, duration_choice, vertical_blur,
                         enable_captions, caption_style, enable_hook, hook_text):
    if not (url or "").strip() and not upload:
        return None, "Paste a YouTube link or upload a video."

    duration = int(duration_choice.replace("s", ""))
    job = uuid.uuid4().hex[:8]
    full = os.path.join(OUTPUT_DIR, f"full_{job}.mp4")
    raw = os.path.join(OUTPUT_DIR, f"raw_{job}.mp4")
    ass = os.path.join(OUTPUT_DIR, f"subs_{job}.ass")
    final = os.path.join(OUTPUT_DIR, f"viral_{job}.mp4")
    try:
        if upload:
            shutil.copy(upload, full)
        else:
            download_youtube_video(url, full, cookies)
        start = find_viral_peak_timestamp(full, duration)
        subprocess.run(
            ["ffmpeg", "-y", "-ss", str(start), "-i", full, "-t", str(duration),
             "-c:v", "libx264", "-c:a", "aac", raw], check=True)
        generate_ass_subtitles(raw, ass, duration, enable_captions,
                               caption_style, enable_hook, hook_text)
        render_vertical_short(raw, final, ass, vertical_blur)
        return final, f"Done! Clip starts at second {int(start)}"
    except Exception as e:
        return None, f"Error: {e}"
    finally:
        for t in (full, raw, ass):
            if os.path.exists(t):
                os.remove(t)


